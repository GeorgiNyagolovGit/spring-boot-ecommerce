option_settings:
  aws:elasticbeanstalk:application:environment:
    PORT: "8080"
    SPRING_PROFILES_ACTIVE: prod
  aws:elasticbeanstalk:environment:process:default:
    Port: "8080"
    Protocol: HTTP
    HealthCheckPath: /actuator/health
    MatcherHTTPCode: "200"
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
